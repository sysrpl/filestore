<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="using:filestore.Helpers"
        x:Class="filestore.Views.ShareLinkDialog"
        Title="Temporary Link"
        SizeToContent="Height"
        Width="500"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="20" Spacing="8">
        <TextBlock x:Name="HeaderText" TextWrapping="Wrap" />
        <Border Background="{DynamicResource MintViewBrush}" CornerRadius="3" Padding="8,6" MaxHeight="130">
            <ScrollViewer>
                <TextBlock x:Name="FileNamesText" TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>

        <TextBlock Text="The link works for" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <NumericUpDown x:Name="AmountBox" Width="130" Minimum="1" Maximum="10080" Increment="1"
                           FormatString="0" Value="1" ValueChanged="Amount_Changed" />
            <ComboBox x:Name="UnitBox" Width="120" SelectionChanged="Unit_Changed">
                <ComboBoxItem Content="minutes" />
                <ComboBoxItem Content="hours" />
                <ComboBoxItem Content="days" />
            </ComboBox>
        </StackPanel>
        <TextBlock x:Name="ExpiresText" Foreground="{DynamicResource MintDimTextBrush}" />
        <TextBlock x:Name="ErrorText" Classes="error" TextWrapping="Wrap" IsVisible="False" />

        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MintDimTextBrush}"
                   Text="Anyone with the link can download the file until it expires (7 days at most). The link is signed with this profile's keys, so it stops working early if those keys are deactivated or deleted." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
            <Button x:Name="CreateButton" Content="Create and copy link" Classes="accent" IsDefault="True"
                    Click="Create_Click"
                    h:Tip.Title="Create and copy link"
                    h:Tip.Text="Create the temporary link and copy it to the clipboard (one line per file)." />
            <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" />
        </StackPanel>
    </StackPanel>
</Window>
