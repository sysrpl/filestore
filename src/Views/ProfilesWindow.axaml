<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="using:filestore.Models"
        x:Class="filestore.Views.ProfilesWindow"
        Title="AWS Profiles"
        Width="720" Height="440"
        MinWidth="600" MinHeight="400"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Close" Click="Close_Click" IsCancel="True" />
        </StackPanel>

        <Grid ColumnDefinitions="220,16,*">
            <!-- Profile list -->
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button Content="New" Click="New_Click" />
                    <Button x:Name="DeleteButton" Content="Delete" Click="Delete_Click" />
                </StackPanel>
                <ListBox x:Name="ProfileList" SelectionChanged="ProfileList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="m:Profile">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Edit form -->
            <StackPanel Grid.Column="2" Spacing="6">
                <TextBlock Text="Friendly name" />
                <TextBox x:Name="NameBox" Watermark="e.g. Client A - Production" />

                <TextBlock Text="Access key ID" Margin="0,6,0,0" />
                <TextBox x:Name="AccessKeyBox" Watermark="AKIA..." />

                <TextBlock Text="Secret access key" Margin="0,6,0,0" />
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox x:Name="SecretKeyBox" PasswordChar="•" />
                    <CheckBox x:Name="ShowSecretCheck" Grid.Column="1" Content="Show"
                              Margin="8,0,0,0" IsCheckedChanged="ShowSecret_Changed" />
                </Grid>

                <TextBlock Text="Region" Margin="0,6,0,0" />
                <ComboBox x:Name="RegionBox" HorizontalAlignment="Stretch" />

                <TextBlock x:Name="ErrorText" Classes="error" TextWrapping="Wrap" IsVisible="False" />

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                    <Button Content="Save" Classes="accent" Click="Save_Click" />
                    <Button x:Name="SetActiveButton" Content="Set as active" Click="SetActive_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
