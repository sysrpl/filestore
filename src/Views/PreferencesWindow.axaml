<v:DialogWindow xmlns="https://github.com/avaloniaui"
        xmlns:v="using:filestore.Views"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="using:filestore.Helpers"
        x:Class="filestore.Views.PreferencesWindow"
        Title="Preferences"
        SizeToContent="Height"
        Width="460"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <DockPanel>
        <StackPanel Classes="dialogButtons" DockPanel.Dock="Bottom">
            <Button Content="OK" Classes="accent" IsDefault="True" Click="Ok_Click" />
            <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" />
        </StackPanel>

        <StackPanel Margin="20,20,20,4" Spacing="8">
            <TextBlock Text="Layout" FontWeight="Bold" />
            <CheckBox x:Name="SwapPanesCheck" Content="Show Amazon S3 on the left and local files on the right"
                      h:Tip.Title="Swap sides"
                      h:Tip.Text="Put the S3 pane on the left and the Local pane on the right. The transfer arrows turn around to match." />

            <TextBlock Text="Toolbar" FontWeight="Bold" Margin="0,10,0,0" />
            <CheckBox x:Name="ShowCaptionsCheck" Content="Show captions on toolbar buttons"
                      h:Tip.Title="Toolbar captions"
                      h:Tip.Text="Show a text label next to each toolbar icon. When off, only the icons show; hover over one to see what it does." />

            <TextBlock Text="Uploads" FontWeight="Bold" Margin="0,10,0,0" />
            <StackPanel Spacing="4">
                <RadioButton x:Name="PrivateDefaultRadio" GroupName="UploadDefault" Content="Private by default (lock starts locked)"
                             h:Tip.Title="Private uploads"
                             h:Tip.Text="Uploaded files can only be read with your AWS keys unless you unlock the lock between the panes." />
                <RadioButton x:Name="PublicDefaultRadio" GroupName="UploadDefault" Content="Public by default (lock starts unlocked)"
                             h:Tip.Title="Public uploads"
                             h:Tip.Text="Uploaded files get the public-read ACL, so anyone with the link can read them. Needs a bucket that allows public ACLs." />
            </StackPanel>
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MintDimTextBrush}"
                       Text="Saving these preferences also sets the lock between the panes to this default." />

            <TextBlock x:Name="ErrorText" Classes="error" TextWrapping="Wrap" IsVisible="False" />
        </StackPanel>
    </DockPanel>
</v:DialogWindow>
