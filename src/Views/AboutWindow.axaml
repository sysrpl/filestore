<v:DialogWindow xmlns="https://github.com/avaloniaui"
        xmlns:v="using:filestore.Views"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="filestore.Views.AboutWindow"
        Title="About"
        SizeToContent="Height"
        Width="520"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="Grid#DetailsGrid > TextBlock.name">
            <Setter Property="Foreground" Value="{DynamicResource MintDimTextBrush}" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <StackPanel Classes="dialogButtons" DockPanel.Dock="Bottom">
            <Button Content="Copy build information" Click="CopyDetails_Click" />
            <Button Content="Close" Classes="accent" IsDefault="True" IsCancel="True" Click="Close_Click" />
        </StackPanel>

        <StackPanel Margin="24,20,24,4" Spacing="12">
            <Grid ColumnDefinitions="Auto,*">
                <!-- The app icon -->
                <Image Source="/resources/icon.png" Width="48" Height="48"
                       VerticalAlignment="Center" Margin="0,0,16,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="NameText" FontSize="22" FontWeight="Bold" />
                    <TextBlock x:Name="VersionText" Foreground="{DynamicResource MintDimTextBrush}" />
                </StackPanel>
            </Grid>

            <TextBlock TextWrapping="Wrap"
                       Text="A two-pane file manager for Amazon S3. Browse the files on this computer next to your S3 buckets, and copy between them by button, drag and drop, or copy and paste." />
            <TextBlock TextWrapping="Wrap"
                       Text="Keep several AWS accounts as named profiles, stored encrypted. Create, rename and delete folders and buckets; make files public or private; and share them with CloudFront links, S3 links or temporary links that expire." />

            <TextBlock Text="Build information" FontWeight="Bold" Margin="0,6,0,0" />
            <Border Background="{DynamicResource MintViewBrush}" CornerRadius="3" Padding="10,8">
                <!-- Selectable, so it can be copied into a bug report. -->
                <Grid x:Name="DetailsGrid" ColumnDefinitions="Auto,*" />
            </Border>
        </StackPanel>
    </DockPanel>
</v:DialogWindow>
