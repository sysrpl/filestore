<v:DialogWindow xmlns="https://github.com/avaloniaui"
        xmlns:v="using:filestore.Views"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="filestore.Views.TextInputDialog"
        Title="Name"
        SizeToContent="Height"
        Width="460"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <DockPanel>
        <StackPanel Classes="dialogButtons" DockPanel.Dock="Bottom">
            <Button x:Name="OkButton" Content="OK" Classes="accent" IsDefault="True" Click="Ok_Click" />
            <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" />
        </StackPanel>

        <StackPanel Margin="20,20,20,4" Spacing="10">
            <TextBlock x:Name="PromptText" TextWrapping="Wrap" />
            <TextBox x:Name="InputBox" />
            <TextBlock x:Name="ErrorText" Classes="error" TextWrapping="Wrap" IsVisible="False" />
        </StackPanel>
    </DockPanel>
</v:DialogWindow>
